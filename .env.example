# local: planificador determinista, sin llamadas a un proveedor.
# openai: API compatible con OpenAI. La clave solo vive en el servidor.
LLM_PROVIDER=local

# Obligatorio únicamente si LLM_PROVIDER=openai. No la subas al repositorio.
OPENAI_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

MAX_TOOL_ITERATIONS=25
MAX_SESSION_TOKENS=24000
MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_MS=60000
PORT=3000
HOST=0.0.0.0
